{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "dev": "pnpm --filter @workspace/furniture-flip run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test": "pnpm --filter @workspace/api-server run test:auth",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
