# Required to encrypt user-supplied provider API keys at rest.
# Generate a base64-encoded 32-byte value; never commit the real value.
ENCRYPTION_KEY=

# Optional comma-separated owner/admin accounts that always receive Pro.
LIFETIME_PRO_EMAILS=owner@example.com

# Normal deployment configuration.
PORT=8080
SESSION_SECRET=
DATABASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
