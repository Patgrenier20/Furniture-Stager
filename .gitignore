npm-debug.log
yarn-error.log
testem.log
/typings

# environment files
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# System Files
.DS_Store
Thumbs.db

# Local tool state
.cache/
.local/

# Local embedded PostgreSQL data used when DATABASE_URL is not configured
.local-data/

